{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/x-archive/post.schema.json",
  "title": "X Archive Post",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "platform",
    "account",
    "published_at",
    "content",
    "url"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "platform": {
      "type": "string",
      "const": "x"
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "username"
      ],
      "properties": {
        "username": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{1,15}$"
        },
        "display_name": {
          "type": "string"
        }
      }
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "content": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "source_url"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video",
              "gif"
            ]
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "local_path": {
            "type": "string"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "collector": {
          "type": "string"
        }
      }
    }
  }
}
